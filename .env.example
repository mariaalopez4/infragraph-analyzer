# ==============================================================================
# InfraGraph Analyzer - Environment Variables Template
# ==============================================================================
# Copy this file to .env before running the application locally or via Docker:
#   cp .env.example .env
# Do not commit your real .env file with production secrets to version control.
# ==============================================================================

# Neo4j Database Configuration
# When connecting from another Docker container in compose, use: bolt://neo4j:7687
# When running python locally against Docker Neo4j, use: bolt://localhost:7687
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=infragraph_secret_dev

# Neo4j Local Port Bindings (Host machine)
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# FastAPI Application Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
